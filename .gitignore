# Gemini image pipeline: PNG masters stay local, only .webp is committed.
# Exception: the OG card is composed deterministically by sharp, not generated,
# and must be committed because crawlers fetch it as a PNG.
/public/img/**/*.png
!/public/img/og/*.png
/scripts/.gen-logs/
/scripts/.gen-prompts/
