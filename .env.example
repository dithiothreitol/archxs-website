# Copy to .env.local for development, or set as repository secrets for CI.
# All are optional — the site builds and runs without them.

# Contact form relay (https://web3forms.com). Without it the form renders a
# plain "not configured, email us instead" note rather than pretending to send.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Search Console / Bing verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Gemini image pipeline (scripts/generate-archxs-images.ts). Local only —
# generated PNGs are converted to .webp and only the .webp files are committed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image-preview
